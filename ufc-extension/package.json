{
  "name": "ufc-connector",
  "displayName": "UFC Connector",
  "version": "1.0.0",
  "description": "Conecta o SIGAA ao UFC Presença, permitindo capturar e sincronizar dados de frequência com consentimento do usuário.",
  "author": "Robson Lopes Cavalcante",
  "scripts": {
    "dev": "plasmo dev",
    "build": "plasmo build",
    "dev:edge": "plasmo dev --target=edge-mv3",
    "build:edge": "plasmo build --target=edge-mv3",
    "dev:firefox": "plasmo dev --target=firefox-mv3",
    "build:firefox": "plasmo build --target=firefox-mv3",
    "package": "plasmo package"
  },
  "dependencies": {
    "@plasmohq/messaging": "^0.7.2",
    "@plasmohq/storage": "^1.15.0",
    "jwt-decode": "^4.0.0",
    "plasmo": "0.90.5",
    "react": "18.2.0",
    "react-dom": "18.2.0"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "4.1.1",
    "@types/chrome": "0.0.258",
    "@types/node": "20.11.5",
    "@types/react": "18.2.48",
    "@types/react-dom": "18.2.18",
    "autoprefixer": "^10.4.21",
    "postcss": "8.4.33",
    "prettier": "3.2.4",
    "tailwindcss": "3",
    "typescript": "5.3.3"
  },
  "manifest": {
    "permissions": [
      "cookies",
      "storage"
    ],
    "host_permissions": [
      "https://si3.ufc.br/*",
      "https://localhost:3000/*",
      "http://localhost:3333/*"
    ]
  }
}
